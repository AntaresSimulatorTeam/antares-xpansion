{
  "name": "antares-xpansion",
  "version-string": "1.7.4",
  "$comment 1": "libuuid by transitivity for Simulator-> yuni",
  "$comment 2": "sirius-solver by transitivity for Simulator",
  "$comment 3": "antlr4 by transitivity for Simulator",
  "$comment 4": "set coin version to avoid change in results for now",
  "$comment 5": "boost iostreams by transitivity for Simulator",
  "dependencies": [
    "jsoncpp",
    "gtest",
    "gflags",
    "sirius-solver",
    "coin-or-cbc",
    {
      "name": "libuuid",
      "platform": "!windows"
    },
    {
      "name": "boost-mpi",
      "version>=": "1.81.0"
    },
    {
      "name": "boost-program-options",
      "version>=": "1.81.0"
    },
    {
      "name": "boost-algorithm",
      "version>=": "1.81.0"
    },
    {
      "name": "boost-iostreams",
      "version>=": "1.81.0"
    },
    "yaml-cpp",
    "antlr4",
    {
      "name": "minizip-ng",
      "default-features": false,
      "version>=": "4.0.0",
      "features": [
        "zlib"
      ]
    },
    "tbb",
    "fmt",
    "catch2"
  ],
  "overrides": [
    {
      "name": "tbb",
      "version-string": "2022.2.0"
    },
    {
      "name": "coin-or-cbc",
      "version": "2.10.7"
    },
    {
      "name": "coin-or-cgl",
      "version": "0.60.5"
    },
    {
      "name": "coin-or-clp",
      "version": "1.17"
    },
    {
      "name": "coin-or-osi",
      "version": "0.108.7"
    },
    {
      "name": "coinutils",
      "version": "2.11.12"
    }
  ]
}
