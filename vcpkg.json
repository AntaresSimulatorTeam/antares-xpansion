{
  "name": "antares-xpansion",
  "version-string": "1.4.0",
  "$comment 1": "libuuid by transitivity for Simulator-> yuni",
  "$comment 2": "sirius-solver by transitivity for Simulator",
  "$comment 3": "antlr4 by transitivity for Simulator",
  "dependencies": [
    "jsoncpp",
    "gtest",
    "gflags",
    "sirius-solver",
    "coin-or-cbc",
    {
      "name": "libuuid",
      "platform": "!windows"
    },
    {
      "name": "boost-mpi",
      "version>=": "1.81.0"
    },
    {
      "name": "boost-program-options",
      "version>=": "1.81.0"
    },
    {
      "name": "boost-algorithm",
      "version>=": "1.81.0"
    },
    "yaml-cpp",
    "antlr4",
    {
      "name": "minizip-ng",
      "default-features": false,
      "version>=": "4.0.0",
      "features": [
        "zlib"
      ]
    },
    "tbb",
    "fmt"
  ],
  "overrides": [
    {
      "name": "tbb",
      "version-string": "2020_U3"
    }
  ]
}
